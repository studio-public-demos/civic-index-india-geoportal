{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geoindia.nebulacloud.in/schemas/civic-index.schema.json",
  "title": "Nebula Civic Index — dataset record",
  "description": "Schema for a single geospatial dataset record in the Nebula Civic Index catalogue. Loosely aligned to DCAT / GeoDCAT concepts.",
  "type": "object",
  "required": ["id", "title", "portal", "theme", "coverage", "url"],
  "properties": {
    "id": { "type": "string", "description": "Stable unique identifier." },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "portal": { "type": "string", "description": "Reference to portals.json id." },
    "theme": { "type": "string", "description": "Reference to themes.json id (16 fixed groups)." },
    "coverage": { "type": "string", "description": "All India, Global, Regional, Multi-state, or a state/UT name." },
    "state": { "type": ["string", "null"], "description": "Canonical state/UT name when coverage is a single state." },
    "formats": { "type": "array", "items": { "type": "string" }, "description": "Distribution formats (GeoJSON, GeoTIFF, Shapefile, CSV, ...)." },
    "access_tier": { "type": "string", "enum": ["Open", "Open (Registration)", "Restricted", "Academic", "Paid", "Mixed", "Not specified"] },
    "licence": { "type": "string" },
    "url": { "type": "string", "format": "uri" },
    "source_class": { "type": "string", "enum": ["authoritative", "open-community", "global-open", "eo-derived"] },
    "downloadable": { "type": "boolean" },
    "api": { "type": "boolean" },
    "ogc": { "type": "boolean" },
    "machine_readable": { "type": "boolean" },
    "gis_ready": { "type": "boolean" },
    "api_ready": { "type": "boolean" },
    "published_year": { "type": ["integer", "string", "null"], "pattern": "^[0-9]{4}$" },
    "updated_year": { "type": ["integer", "string", "null"], "pattern": "^[0-9]{4}$" },
    "keywords": { "type": "array", "items": { "type": "string" } },
    "link_health": { "type": "string", "enum": ["live", "dead", "down", "unverified", "not_checked"] },
    "verified_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "additionalProperties": false
}
